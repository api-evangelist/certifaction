{
  "opencollection": "1.0.0",
  "info": {
    "name": "{{ .ProductName }} Admin Account API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Check account QES status",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{ .APIServerURL }}/qes/check",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Check account QES status"
        },
        {
          "info": {
            "name": "Get account data",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{ .APIServerURL }}/user"
          },
          "docs": "Get account data"
        }
      ]
    }
  ],
  "bundled": true
}